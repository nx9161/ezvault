# EZVault — environment variables (ALL PLACEHOLDERS — never commit real values)
# Copy to .env.local for local dev. Production values live in the Vercel dashboard only.

# Neon Postgres (HTTP driver). Get from the Neon dashboard after creating the project.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/ezvault?sslmode=require

# Cloudflare R2 (S3-compatible). Get from the Cloudflare dashboard (R2 > Manage R2 API tokens).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_DATA=ezvault-data
R2_BUCKET_BACKUPS=ezvault-backups

# Shared secret guarding /api/cron/nightly (bearer token). Generate: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32
